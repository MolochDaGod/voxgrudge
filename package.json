{
  "name": "voxgrudge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Grudge Warlords open-world voxel — R2 CDN delivery + glTF pipeline",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "dev": "node scripts/preflight-dev.mjs && node scripts/dev.mjs",
    "dev:game": "node scripts/dev-static.mjs",
    "dev:server": "npm run dev --prefix server",
    "dev:check": "node scripts/health-dev.mjs",
    "fix": "npm install --ignore-scripts && npm run convert:doctor && npm run sync:tvs && node scripts/dev-static.mjs",
    "verify:hud-icons": "node scripts/verify-hud-icons.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:assets:cdn": "node scripts/verify-assets.mjs --cdn-only",
    "optimize:glb": "node scripts/optimize-glb.mjs",
    "optimize:glb:all": "node scripts/optimize-glb.mjs --all",
    "convert": "node scripts/convert-pipeline.mjs",
    "convert:doctor": "node scripts/convert-pipeline.mjs doctor",
    "convert:tvs": "node scripts/convert-tvs-heroes.mjs",
    "upload:tvs": "node scripts/upload-tvs-production.mjs",
    "upload:tvs:races": "node scripts/upload-tvs-races.mjs",
    "upload:tvs:anims": "node scripts/upload-tvs-anims.mjs",
    "upload:cse:sfx": "node scripts/upload-cse-sfx.mjs",
    "upload:tvs:all": "node scripts/upload-tvs-races.mjs && node scripts/upload-tvs-production.mjs && node scripts/upload-tvs-anims.mjs && node scripts/upload-cse-sfx.mjs",
    "export:tvs:skins": "node scripts/export-tvs-skin-palette.mjs",
    "sync:tvs": "node scripts/sync-tvs-production.mjs",
    "pull:tvs:sidecars": "node scripts/pull-tvs-sidecars.mjs",
    "pipeline:tvs": "node scripts/pull-tvs-sidecars.mjs && node scripts/sync-tvs-production.mjs && node scripts/upload-tvs-production.mjs",
    "pipeline:tvs:ship": "node scripts/pipeline-tvs-ship.mjs",
    "publish:tvs:examples": "node scripts/publish-tvs-game-examples.mjs",
    "verify:tvs": "node scripts/verify-tvs-cdn.mjs",
    "verify:tvs:strict": "node scripts/verify-tvs-cdn.mjs --strict",
    "pipeline:local": "npm run convert:doctor && npm run sync:tvs",
    "sync:grudox": "node scripts/sync-voxgrudge-to-grudox.mjs",
    "deploy:prod": "npx vercel --prod --yes",
    "deploy:edge": "node scripts/sync-voxgrudge-to-grudox.mjs && npx wrangler deploy --cwd F:/GitHub/grudox/carrier-site",
    "deploy:grudox": "node scripts/sync-voxgrudge-to-grudox.mjs && npx vercel --prod --yes --cwd F:/GitHub/grudox",
    "deploy:all": "npm run deploy:prod && npm run deploy:grudox && npm run deploy:edge",
    "start:server": "npm start --prefix server",
    "postinstall": "node -e \"try{require('child_process').execSync('npm install --prefix server',{stdio:'inherit'})}catch(e){console.warn('[postinstall] server optional',e.message)}\""
  },
  "engines": {
    "node": ">=18"
  },
  "grudgeThreeTrack": "cdn-r128-pinned",
  "grudgeThreeNote": "Browser games pin three@0.128 via CDN (Vercel static). Offline bake uses @gltf-transform + grudge-convert. Fleet r185 is Mine-Loader/Open — not this SPA.",
  "grudgeAssets": {
    "cdn": "https://assets.grudge-studio.com",
    "appPrefix": "voxgrudge",
    "bucket": "grudge-assets",
    "tvs": "models/voxels/tvs",
    "playerHeightM": 2,
    "humanHeightM": 1.8
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.33.5"
  },
  "optionalDependencies": {
    "draco3dgltf": "^1.5.7",
    "fflate": "^0.8.2"
  }
}
