# voxgrudge local development (copy to .env.local)
# Three.js track: CDN r128 + fflate (see @grudge/three-stack / js/three-stack-check.js)

DEV_PORT=3000
GRUDOX_PORT=8787
DEV_HOST=127.0.0.1

# Comma-separated browser origins allowed by the local GRUDOX room server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://test.grudge-studio.com,https://voxgrudge.vercel.app,https://vox.grudge-studio.com,https://grudge-studio.com,https://mine-loader.replit.app

# GRUDOX room tick rate and capacity (local server only)
TICK_HZ=20
MAX_PLAYERS=16

# Fleet URLs (browser uses same-origin or id gateway in production)
AUTH_GATEWAY=https://id.grudge-studio.com
API_BASE=https://api.grudge-studio.com
ASSETS_CDN=https://assets.grudge-studio.com
OBJECTSTORE=https://objectstore.grudge-studio.com

# Public URLs (printed by npm run dev)
TEST_URL=https://test.grudge-studio.com
PROD_URL=https://voxgrudge.vercel.app
EMBED_URL=https://grudge-studio.com/embed/vox/