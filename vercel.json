{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/grudox",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/api/grudox"
    },
    {
      "source": "/api/grudox/:path*",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/api/grudox/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/health"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/api/auth/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/login",
      "destination": "https://id.grudge-studio.com/login"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/account",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/treaty",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/treaty"
    },
    {
      "source": "/api/treaty/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/treaty/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/grudge-warlords-openworld.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Grudge-App", "value": "voxgrudge" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://grudge-studio.com https://*.grudge-studio.com https://grudgewarlords.com https://*.vercel.app; default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://static.cloudflareinsights.com https://*.grudge-studio.com https://*.vercel.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: http:; connect-src 'self' https: wss: blob:; worker-src 'self' blob:"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/grudge-warlords-openworld.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
