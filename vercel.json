{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/vendor/puter.js",
      "destination": "https://js.puter.com/v2/"
    },
    {
      "source": "/vendor/puter/:path*",
      "destination": "https://js.puter.com/:path*"
    },
    {
      "source": "/models/kenney/Textures/:path*",
      "destination": "/models/kenney/textures/:path*"
    },
    {
      "source": "/assets/grudge-game/class-emblems/druid.webp",
      "destination": "/assets/grudge-game/class-emblems/ranger.webp"
    },
    {
      "source": "/assets/grudge-game/class-emblems/paladin.webp",
      "destination": "/assets/grudge-game/class-emblems/warrior.webp"
    },
    {
      "source": "/assets/grudge-game/class-emblems/necromancer.webp",
      "destination": "/assets/grudge-game/class-emblems/mage.webp"
    },
    {
      "source": "/assets/grudge-game/class-emblems/swordsman.webp",
      "destination": "/assets/grudge-game/class-emblems/warrior.webp"
    },
    {
      "source": "/assets/grudge-game/class-emblems/archer.webp",
      "destination": "/assets/grudge-game/class-emblems/ranger.webp"
    },
    {
      "source": "/api/grudox",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/api/grudox"
    },
    {
      "source": "/api/grudox/:path*",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/api/grudox/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://voxgrudge-grudox-room-production.up.railway.app/health"
    },
    {
      "source": "/api/auth/puter",
      "destination": "/branding/puter-auth-stub.json"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/api/auth/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/login",
      "destination": "https://id.grudge-studio.com/login"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/account",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/treaty",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/treaty"
    },
    {
      "source": "/api/treaty/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/treaty/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/grudge-warlords-openworld.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Grudge-App", "value": "voxgrudge" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://grudge-studio.com https://*.grudge-studio.com https://grudgewarlords.com https://*.vercel.app; default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.puter.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://static.cloudflareinsights.com https://grudge-studio.com https://*.grudge-studio.com https://*.vercel.app https://vercel.live https://id.grudge-studio.com https://client.grudge-studio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: http:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss: blob: https://vercel.live wss://vercel.live; media-src 'self' https: blob: data:; worker-src 'self' blob:; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/grudge-warlords-openworld.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
